# Result Guardian — copy to .env and fill in. NEVER commit .env.
# On NODE A in production this file is owned by root with 0600 perms. Phase 10.1.

# ── Environment ───────────────────────────────────────────────────
RG_ENV=dev                      # dev | staging | prod
RG_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
TZ=Asia/Kolkata                 # timestamps stored UTC, displayed IST

# ── Database (NODE A) ─────────────────────────────────────────────
POSTGRES_DB=result_guardian
POSTGRES_USER=rg_app
POSTGRES_PASSWORD=change-me-before-anything-real
# Host port for dev only. 5433 avoids a clash with a native PostgreSQL install.
POSTGRES_HOST_PORT=5433

# ── Auth ──────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
RG_JWT_SECRET=change-me-generate-a-real-secret

# ── NODE B — inference ────────────────────────────────────────────
# The ONE line that switches inference targets. Use the literal LAN IP:
# inside the API container, "localhost" and "host.docker.internal" do NOT
# reach NODE B. See docs/network-runbook.md.
#
#   router          http://192.168.1.50:11434
#   phone hotspot   http://172.20.10.3:11434
#   direct ethernet http://10.0.0.2:11434
RG_LLM_BASE_URL=http://192.168.1.50:11434

# Admin kill switch. false forces the degraded path without touching the
# network: retrieval still runs, generation is skipped. Phase 5.4 / 8.4.
RG_LLM_ENABLED=true

RG_LLM_TIMEOUT_S=30
# 4 GB VRAM on the current NODE B, so 4b not 8b. docs/adr/0005.
RG_LLM_MODEL=qwen3:4b

# ── Web ───────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
RG_CORS_ORIGINS=http://localhost,http://localhost:5173
