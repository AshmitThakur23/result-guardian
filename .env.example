# Result Guardian — copy to .env and fill in. NEVER commit .env.
# On NODE A in production this file is owned by root with 0600 perms. Phase 10.1.

# ── Environment ───────────────────────────────────────────────────
RG_ENV=dev                      # dev | staging | prod
RG_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
TZ=Asia/Kolkata                 # timestamps stored UTC, displayed IST

# ── Database (NODE A) ─────────────────────────────────────────────
POSTGRES_DB=result_guardian
POSTGRES_USER=rg_app
POSTGRES_PASSWORD=change-me-before-anything-real
# Host port for dev only. 5433 avoids a clash with a native PostgreSQL install.
POSTGRES_HOST_PORT=5433

# ── Auth ──────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
RG_JWT_SECRET=change-me-generate-a-real-secret

# Failed login attempts allowed per source address per minute, before the
# endpoint answers 429. Phase 5.7. This is NOT the account lockout — that is
# 5 failures / 15 minutes and is counted on the account, in code.
#
# Default when unset: 20. In-process and per API container, so a deployment
# running more than one would get one allowance each.
#
# ⚠️ docker-compose.override.yml (DEV ONLY) raises this to 500 so the E2E
# suite, which signs in before nearly every navigation from one browser, does
# not throttle itself. A hospital deployment uses docker-compose.yml alone and
# gets the default.
RG_AUTH_RATE_LIMIT_PER_MINUTE=20

# ── Webhooks ──────────────────────────────────────────────────────
# Shared secret for the SMS provider's delivery-receipt callback
# (POST /api/notifications/delivery-receipt). That endpoint is the only one
# with no user behind it, so it cannot carry a bearer token and sits outside
# RBAC; this is what authenticates it instead. The provider must send the
# value in an `X-Webhook-Secret` header.
#
# 🔴 CONFIGURE THIS BEFORE ANY REAL-PATIENT PILOT.
#
# Left unset the webhook is UNAUTHENTICATED: anyone who can reach NODE A's
# port can assert that a patient's message was delivered. That is not a data
# leak — it is worse in one specific way. It FALSIFIES THE EVIDENCE that a
# patient was reached, which is the number Phase 5.6's patient-contact metric
# and a NABH reviewer both rely on. The endpoint logs a warning on every call
# while it is unset, and that warning is the only thing making it visible.
#
# It is unset by default only so that upgrading to Phase 5 does not break a
# working Phase 4 SMS integration. **The unset state must not be used for a
# real-patient deployment.**
#
# Treat it like RG_JWT_SECRET: keep it private, never commit it, never put it
# in a URL or a ticket, and rotate it if it is ever exposed. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RG_WEBHOOK_SECRET=

# ── Document ingestion — Phase 6 ──────────────────────────────────
# Where uploaded reports and rendered page images live. These paths are
# inside the container and are backed by the `rgdocs` named volume, which
# BOTH the api and the worker mount. They must stay the same in both
# services: the API writes uploads and serves page images, the worker renders
# them. Point them at two different places and every page image 404s.
#
# ⚠️ These files are clinical records. `documents.storage_path` points at
# them and the database holds no copy of the bytes. Back up this volume with
# the database — see docs/runbook.md §10.
RG_DOCUMENT_ROOT=/data/documents

# The watched folder, for labs that hand over results by dropping files on a
# share. A file moves inbox -> processing -> archive/YYYY/MM/DD and is never
# deleted.
#
# Off by default: a hospital that only uses the upload form should not have a
# poller walking a directory that will never exist. Turn it on only once the
# share is actually mounted into the container.
RG_WATCHED_FOLDER_ENABLED=false
RG_INBOX_DIR=/data/inbox
RG_PROCESSING_DIR=/data/processing
RG_ARCHIVE_DIR=/data/archive

# 6.1: "multipart, max 25 MB". Raising this raises what a single request can
# make the server hold and hash, so raise it only with a reason.
RG_UPLOAD_MAX_BYTES=26214400

# 🔴 CONFIGURE THIS BEFORE ANY REAL-PATIENT PILOT.
#
# The virus scanner. 6.1 requires a scan BEFORE processing, and an uploaded
# file is the one thing in this system that arrives from outside it.
#
# Left empty, NO SCAN HAPPENS. The system is honest about that -- every such
# document is recorded as `skipped`, never `clean`, and the upload screen says
# so -- but honesty is not protection. A hospital deployment should run a
# clamav container on the compose network and set this to its hostname.
#
#   RG_CLAMAV_HOST=clamav
RG_CLAMAV_HOST=
RG_CLAMAV_PORT=3310
RG_CLAMAV_TIMEOUT_S=30

# When a scanner IS configured but unreachable, refuse the file rather than
# processing it unscanned. A scanner that is down is not a scanner that found
# nothing. Set false only in a deployment that has accepted that risk in
# writing.
RG_CLAMAV_REQUIRED=true

# DPI for rendered page images. Used for OCR input and for the side-by-side
# fallback view. 200 is the plan's floor for OCR; raising it makes pages
# sharper, slower to produce and larger on disk.
RG_PAGE_RENDER_DPI=200

# ⚠️ NOT set here: the OCR confidence floor (0.70), the scanned-page
# threshold, and the 120s extraction timeout. Those are CLINICAL thresholds
# and live in the `system_settings` table so an admin can change them without
# a redeploy and the change is audited. See
# api/app/services/documents/settings.py.

# ── NODE B — inference ────────────────────────────────────────────
# The ONE line that switches inference targets. Use the literal LAN IP:
# inside the API container, "localhost" and "host.docker.internal" do NOT
# reach NODE B. See docs/network-runbook.md.
#
#   router          http://192.168.1.50:11434
#   phone hotspot   http://172.20.10.3:11434
#   direct ethernet http://10.0.0.2:11434
RG_LLM_BASE_URL=http://192.168.1.50:11434

# Admin kill switch. false forces the degraded path without touching the
# network: retrieval still runs, generation is skipped. Phase 5.4 / 8.4.
RG_LLM_ENABLED=true

RG_LLM_TIMEOUT_S=30
# 4 GB VRAM on the current NODE B, so 4b not 8b. docs/adr/0005.
RG_LLM_MODEL=qwen3:4b

# ── Web ───────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
RG_CORS_ORIGINS=http://localhost,http://localhost:5173
